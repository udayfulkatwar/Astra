{
  "id": "astraErrorHandle",
  "name": "ASTRA — Error handler",
  "nodes": [
    {
      "id": "859d0326-8f34-44ce-8d4d-8a1d402c39a5",
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "89a494e2-2840-4864-8d40-a4d5415b47a8",
      "name": "Report to ASTRA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8080/api/v1/automation/errors",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: $json.workflow?.name ?? 'unknown', error: String($json.execution?.error?.message ?? 'unknown error').slice(0, 4000), workflowRunId: String($json.execution?.id ?? '') }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "astraAutomationT",
          "name": "ASTRA automation token"
        }
      }
    }
  ],
  "connections": {
    "On workflow error": {
      "main": [
        [
          {
            "node": "Report to ASTRA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {},
  "meta": {
    "astra": "Error workflow of every ASTRA workflow: failures appear in ASTRA live activity (and, as ERROR events, in alerts)."
  }
}
