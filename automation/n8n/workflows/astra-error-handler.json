{
  "name": "ASTRA — Error handler",
  "nodes": [
    {
      "parameters": {},
      "id": "7c1d2e3f-4a5b-4c6d-8e9f-000000000001",
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8080/api/v1/automation/errors",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: $json.workflow?.name ?? 'unknown', error: String($json.execution?.error?.message ?? 'unknown error').slice(0, 4000), workflowRunId: String($json.execution?.id ?? '') }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "7c1d2e3f-4a5b-4c6d-8e9f-000000000002",
      "name": "Report to ASTRA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "astra-automation-token", "name": "ASTRA automation token" }
      }
    }
  ],
  "connections": {
    "On workflow error": { "main": [[{ "node": "Report to ASTRA", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "meta": { "astra": "Set as the error workflow of every ASTRA workflow; failures appear in ASTRA's live activity." }
}
