    "@astra/decision": "workspace:*",
    "@astra/journal": "workspace:*",
    "@astra/market-data": "workspace:*",
    "@astra/market-structure": "workspace:*",
    "@astra/news": "workspace:*",
    "@astra/prop-firm": "workspace:*",
    "@astra/risk": "workspace:*",
    "@astra/safety": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astra/config": "workspace:*"
  }
}
