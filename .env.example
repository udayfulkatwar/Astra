# ASTRA environment — copy to .env and fill in. NEVER commit .env.
# Generate secrets with:  openssl rand -hex 32

# --- Database ---------------------------------------------------------------
POSTGRES_PASSWORD=
N8N_DB_PASSWORD=
# Only needed when running the API outside docker compose (pnpm dev):
DATABASE_URL=postgres://astra:CHANGE_ME@localhost:5432/astra

# --- ASTRA API access tokens (distinct, >= 32 chars) ------------------------
# operator: the human (dashboard, kill switches, mode, execution)
ASTRA_OPERATOR_TOKEN=
# automation: n8n (heartbeats, data ingestion, candidate submission)
ASTRA_AUTOMATION_TOKEN=
# viewer (optional): read-only dashboards
ASTRA_VIEWER_TOKEN=

# --- AI analysis (Phase 6) ---------------------------------------------------
# Anthropic API key (the variable NAME is set in config/astra.yaml ai.providers.anthropic.apiKeyEnv).
# Empty: AI analysis is unavailable, so strategies that require it take no trades.
ANTHROPIC_API_KEY=

# --- n8n --------------------------------------------------------------------
N8N_ENCRYPTION_KEY=
# Pin a tested n8n version for reproducible deployments (e.g. a specific 1.x/2.x tag).
N8N_IMAGE_TAG=latest
# true when n8n is served over HTTPS
N8N_SECURE_COOKIE=false

# --- Behaviour --------------------------------------------------------------
ASTRA_LOG_LEVEL=info
ASTRA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# SIMULATED market/calendar feeds for paper testing. SHADOW and LIVE refuse simulated data.
ASTRA_SIMULATION=false
# One of six factors required before any live order (ADR-0008). Keep false.
ASTRA_LIVE_TRADING_AUTHORIZED=false
